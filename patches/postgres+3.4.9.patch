         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      const written = write(toBuffer(q))
+      // Patch local (porsager/postgres#1218): o hook de reserva do sql.begin
+      // precisa rodar sempre que a query foi escrita. Como último termo do &&
+      // ele era pulado quando o pipeline estava cheio (ou com max_pipeline: 0),
+      // e o BEGIN ficava numa conexão não reservada (UNSAFE_TRANSACTION).
+      if (q.options.onexecute) {
+        q.options.onexecute(connection)
+        return false
+      }
+      return written
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
